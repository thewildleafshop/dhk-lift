generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  phone         String?
  country       String?
  role          Role           @default(MEMBER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  applications  Application[]
  documents     Document[]
  donations     Donation[]
  membership    Membership?
  notifications Notification[]
  partner       Partner?
  sessions      Session[]
  stories       Story[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id           String    @id @default(cuid())
  userId       String    @unique
  tier         Tier      @default(BRONZE)
  totalDonated Decimal   @default(0) @db.Decimal(12, 2)
  joinedAt     DateTime  @default(now())
  expiresAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  programId       String?
  confirmationNo  String            @unique @default(cuid())
  status          ApplicationStatus @default(DRAFT)
  data            Json
  amountRequested Decimal?          @db.Decimal(12, 2)
  notes           String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  program         Program?          @relation(fields: [programId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  documents       Document[]

  @@index([userId])
  @@index([status])
  @@index([confirmationNo])
}

model Program {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  description  String
  category     String
  status       ProgramStatus        @default(ACTIVE)
  maxAmount    Decimal?             @db.Decimal(12, 2)
  geography    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  applications Application[]
  allocations  DonationAllocation[]
  stories      Story[]

  @@index([slug])
}

model Donation {
  id            String               @id @default(cuid())
  userId        String?
  donorEmail    String
  donorName     String?
  totalAmount   Decimal              @db.Decimal(12, 2)
  currency      String               @default("USD")
  status        DonationStatus       @default(PENDING)
  paymentIntent String?              @unique
  receiptUrl    String?
  isRecurring   Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [id])
  allocations   DonationAllocation[]

  @@index([userId])
  @@index([status])
}

model DonationAllocation {
  id         String   @id @default(cuid())
  donationId String
  programId  String?
  projectId  String?
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  program    Program? @relation(fields: [programId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([donationId])
}

model Partner {
  id         String        @id @default(cuid())
  userId     String        @unique
  orgName    String
  orgType    String
  country    String
  website    String?
  mission    String?
  status     PartnerStatus @default(APPLICANT)
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id])
  projects   Project[]

  @@index([status])
}

model Project {
  id           String               @id @default(cuid())
  partnerId    String
  title        String
  slug         String               @unique
  description  String
  location     String
  goalAmount   Decimal              @db.Decimal(12, 2)
  raisedAmount Decimal              @default(0) @db.Decimal(12, 2)
  status       ProjectStatus        @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  allocations  DonationAllocation[]
  evidence     Evidence[]
  milestones   Milestone[]
  partner      Partner              @relation(fields: [partnerId], references: [id])
  stories      Story[]

  @@index([slug])
  @@index([status])
}

model Milestone {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String     @default("PENDING")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  evidence    Evidence[]
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id            String          @id @default(cuid())
  userId        String
  applicationId String?
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  visibility    VisibilityLevel @default(PRIVATE)
  createdAt     DateTime        @default(now())
  application   Application?    @relation(fields: [applicationId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Evidence {
  id          String          @id @default(cuid())
  projectId   String
  milestoneId String?
  type        String
  fileUrl     String
  description String?
  visibility  VisibilityLevel @default(INTERNAL)
  createdAt   DateTime        @default(now())
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id])
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Story {
  id          String      @id @default(cuid())
  userId      String?
  title       String
  slug        String      @unique
  content     String
  excerpt     String?
  category    String
  status      StoryStatus @default(PENDING)
  authorName  String?
  isAnonymous Boolean     @default(false)
  imageUrl    String?
  programId   String?
  projectId   String?
  submittedAt DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  program     Program?    @relation(fields: [programId], references: [id])
  project     Project?    @relation(fields: [projectId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([slug])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

enum Role {
  ADMIN
  MEMBER
  APPLICANT
  PARTNER
  PROVIDER
  PHARMACY
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  VERIFICATION
  UNDER_REVIEW
  ADDITIONAL_INFO
  APPROVED
  DENIED
  COMPLETED
}

enum ProgramStatus {
  ACTIVE
  COMING_SOON
  WAITLIST
  CLOSED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PartnerStatus {
  APPLICANT
  VERIFIED
  TRUSTED
  SUSPENDED
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDRAISING
  FUNDED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum VisibilityLevel {
  PUBLIC
  MEMBER_DONOR
  INTERNAL
  CONFIDENTIAL
  PRIVATE
}

enum StoryStatus {
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
}
