generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  phone         String?
  country       String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  donations     Donation[]
  membership    Membership?
  partner       Partner?
  documents     Document[]
  notifications Notification[]
  stories       Story[]
  @@index([email])
  @@index([role])
}

enum Role {
  ADMIN
  MEMBER
  APPLICANT
  PARTNER
  PROVIDER
  PHARMACY
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== MEMBERSHIP ====================

model Membership {
  id           String    @id @default(cuid())
  userId       String    @unique
  tier         Tier      @default(BRONZE)
  totalDonated Decimal   @default(0) @db.Decimal(12, 2)
  joinedAt     DateTime  @default(now())
  expiresAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// ==================== ASSISTANCE ====================

model Application {
  id              String            @id @default(cuid())
  userId          String
  programId       String?
  confirmationNo  String            @unique @default(cuid())
  status          ApplicationStatus @default(DRAFT)
  data            Json
  amountRequested Decimal?          @db.Decimal(12, 2)
  notes           String?           @db.Text
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  program   Program?   @relation(fields: [programId], references: [id])
  documents Document[]

  @@index([userId])
  @@index([status])
  @@index([confirmationNo])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  VERIFICATION
  UNDER_REVIEW
  ADDITIONAL_INFO
  APPROVED
  DENIED
  COMPLETED
}

// ==================== PROGRAMS ====================

model Program {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  category    String
  status      ProgramStatus @default(ACTIVE)
  maxAmount   Decimal?      @db.Decimal(12, 2)
  geography   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applications Application[]
    stories      Story[]
  allocations  DonationAllocation[]

  @@index([slug])
}

enum ProgramStatus {
  ACTIVE
  COMING_SOON
  WAITLIST
  CLOSED
}

// ==================== DONATIONS ====================

model Donation {
  id            String         @id @default(cuid())
  userId        String?
  donorEmail    String
  donorName     String?
  totalAmount   Decimal        @db.Decimal(12, 2)
  currency      String         @default("USD")
  status        DonationStatus @default(PENDING)
  paymentIntent String?        @unique
  receiptUrl    String?
  isRecurring   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User?                @relation(fields: [userId], references: [id])
  allocations DonationAllocation[]

  @@index([userId])
  @@index([status])
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model DonationAllocation {
  id         String   @id @default(cuid())
  donationId String
  programId  String?
  projectId  String?
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  program  Program? @relation(fields: [programId], references: [id])
  project  Project? @relation(fields: [projectId], references: [id])

  @@index([donationId])
}

// ==================== PARTNERS ====================

model Partner {
  id         String        @id @default(cuid())
  userId     String        @unique
  orgName    String
  orgType    String
  country    String
  website    String?
  mission    String?       @db.Text
  status     PartnerStatus @default(APPLICANT)
  verifiedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  projects Project[]

  @@index([status])
}

enum PartnerStatus {
  APPLICANT
  VERIFIED
  TRUSTED
  SUSPENDED
}

// ==================== PROJECTS ====================

model Project {
  id           String        @id @default(cuid())
  partnerId    String
  title        String
  slug         String        @unique
  description  String        @db.Text
  location     String
  goalAmount   Decimal       @db.Decimal(12, 2)
  raisedAmount Decimal       @default(0) @db.Decimal(12, 2)
  status       ProjectStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  partner     Partner              @relation(fields: [partnerId], references: [id])
  milestones  Milestone[]
  evidence    Evidence[]
    stories      Story[]
  allocations DonationAllocation[]

  @@index([slug])
  @@index([status])
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  FUNDRAISING
  FUNDED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?   @db.Text
  status      String    @default("PENDING")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence Evidence[]
}

// ==================== DOCUMENTS & EVIDENCE ====================

model Document {
  id            String          @id @default(cuid())
  userId        String
  applicationId String?
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  visibility    VisibilityLevel @default(PRIVATE)
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([userId])
}

model Evidence {
  id          String          @id @default(cuid())
  projectId   String
  milestoneId String?
  type        String
  fileUrl     String
  description String?         @db.Text
  visibility  VisibilityLevel @default(INTERNAL)
  createdAt   DateTime        @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([projectId])
}

enum VisibilityLevel {
  PUBLIC
  MEMBER_DONOR
  INTERNAL
  CONFIDENTIAL
  PRIVATE
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ==================== STORIES & TESTIMONIALS ====================

model Story {
  id          String      @id @default(cuid())
  userId      String?
  title       String
  slug        String      @unique
  content     String      @db.Text
  excerpt     String?
  category    String
  status      StoryStatus @default(PENDING)
  authorName  String?
  isAnonymous Boolean     @default(false)
  imageUrl    String?
  programId   String?
  projectId   String?
  submittedAt DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User?    @relation(fields: [userId], references: [id])
  program Program? @relation(fields: [programId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([status])
  @@index([slug])
}

enum StoryStatus {
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
}

// ==================== SETTINGS ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}